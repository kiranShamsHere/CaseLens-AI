# Supabase > Project Settings > API Keys (publishable key, never a secret/service key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required only for secure server-side account deletion. Keep this secret server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio API key; server-only. Do not add the NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional external API origin; leave empty for this app's same-origin /api routes.
NEXT_PUBLIC_API_BASE_URL=
